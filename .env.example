# APP_URL: The canonical URL where this EDUVERSE deployment is hosted (no trailing slash).
APP_URL="https://eduverse.example.com"

# Public Supabase configuration (safe for browser bundle)
VITE_SUPABASE_URL="https://suldaiuxaxremmfxodak.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_CANONICAL_DOMAIN="https://eduverse.example.com"

# Server-only Supabase configuration (NEVER prefix with VITE_)
SUPABASE_URL="https://suldaiuxaxremmfxodak.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Server-only Video Playback Token Signing Secret (generate a 64-char random hex string)
VIDEO_TOKEN_SECRET="CHANGE_ME_TO_A_STRONG_64_CHAR_RANDOM_SECRET"

# Optional External Video / DRM Provider (Mux / Cloudflare Stream / Bunny Stream / VdoCipher)
VIDEO_PROVIDER="supabase_signed"
VIDEO_PROVIDER_KEY_ID=""
VIDEO_PROVIDER_SECRET=""
DRM_WIDEVINE_LICENSE_URL=""
DRM_FAIRPLAY_LICENSE_URL=""
DRM_PLAYREADY_LICENSE_URL=""

# Optional Payment Provider Webhook Secret (Paymob / Fawry / Kashier)
PAYMENT_PROVIDER=""
PAYMENT_WEBHOOK_SECRET=""

# Optional SMS Provider for Phone Password Recovery (Twilio / Infobip)
SMS_PROVIDER=""
SMS_API_KEY=""

# Optional Gemini API key (server-side only if AI study tools are enabled)
GEMINI_API_KEY=""
